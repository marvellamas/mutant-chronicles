      },
      {
        "id": "nmupe0shntkxa",
        "data": "0506-03-22",
        "fascia": "mattina",
        "testo": "Abbiamo avuto un secondo incontro con il consiglio in cui Oshi ha litigato pesantemente con lo stesso procurando il nostro allontaamento da Paradise",
        "colore": "rosso",
        "ricordare": false,
        "creato": "2026-10-01T10:24:46.139Z"
      },
      {
        "id": "nmupe1fp8c8dl",
        "data": "0506-03-21",
        "fascia": "sera",
        "testo": "Primo giorno di Festa Joe Granata si incendia per futili motivi alla festa e ci inimica l'intero villaggio",
        "colore": "rosso",
        "ricordare": false,
