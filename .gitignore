# Dipendenze e cache di Node (solo per i test: nessuna dipendenza a runtime)
node_modules/
.npm/
npm-debug.log*
*.log
coverage/

# File di sistema
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Variabili locali
.env
.env.*

# Impostazioni locali di Claude Code
.claude/

# Originali delle immagini (1254×1254, 2–3 MB l'uno): non si servono e non si tracciano.
# Le versioni per l'app si generano con tools/genera_immagini.py (README, «Immagini»).
img/originali/

# prompt di lavoro (non fanno parte dell'app)
Claude outputs/

# Personaggi salvati dal server di Mutant (server.mjs): dati dei giocatori, non codice.
# Si traccia solo il LEGGIMI che spiega la cartella.
personaggi/*
!personaggi/LEGGIMI.txt

# Selezione «al tavolo» e stato del Tavolo del Master (server.mjs): dati di gioco; si traccia solo il LEGGIMI
tavolo/*
!tavolo/LEGGIMI.txt

# Scontri del Tavolo del Master (server.mjs): dati di gioco; si traccia solo il LEGGIMI
scontri/*
!scontri/LEGGIMI.txt

# Bestiario della campagna del Tavolo del Master (server.mjs): dati del master; si traccia solo il LEGGIMI
nemici/*
!nemici/LEGGIMI.txt

# Registro dei veicoli del Tavolo del Master (server.mjs, A.91): dati di gioco; si traccia solo il LEGGIMI
veicoli/*
!veicoli/LEGGIMI.txt

# Copie di fine sessione (salva-sessione.bat, tools/salva-sessione.mjs): dati di gioco; si traccia solo il LEGGIMI
salvataggi/*
!salvataggi/LEGGIMI.txt
# configurazione della copia (cartella di Drive, clone del repository privato): personale, non va su GitHub
config-salvataggi.json

# Mappa di battaglia (server.mjs, docs/battlemap/): scene e immagini delle mappe; si traccia solo il LEGGIMI
scene/*
!scene/LEGGIMI.txt
mappe/*
!mappe/LEGGIMI.txt

# Musica di fondo della mappa (server.mjs → /api/musica, 07/10): file del master; si traccia solo il LEGGIMI
musica/*
!musica/LEGGIMI.txt

# Avvisi a Marcello con ntfy.sh (tools/avvisi.mjs): configurazione e stato di ogni PC; si tracciano LEGGIMI ed esempio
avvisi/avvisi.json
avvisi/stato.json
