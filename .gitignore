# Dipendenze e cache di Node (solo per i test: nessuna dipendenza a runtime)
node_modules/
.npm/
npm-debug.log*
*.log
coverage/

# File di sistema
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Variabili locali
.env
.env.*

# Impostazioni locali di Claude Code
.claude/

# Originali delle immagini (1254×1254, 2–3 MB l'uno): non si servono e non si tracciano.
# Le versioni per l'app si generano con tools/genera_immagini.py (README, «Immagini»).
img/originali/

# prompt di lavoro (non fanno parte dell'app)
Claude outputs/

# Personaggi salvati dal server di Mutant (server.mjs): dati dei giocatori, non codice.
# Si traccia solo il LEGGIMI che spiega la cartella.
personaggi/*
!personaggi/LEGGIMI.txt

# Selezione «al tavolo» e stato del Tavolo del Direttore (server.mjs): dati di gioco, non codice
tavolo/
